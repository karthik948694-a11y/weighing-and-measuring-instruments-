# Legal Metrology Verification System (LMVS) - Environment Configuration
PORT=5000

# MongoDB Atlas Connection URI:
# 1. Sign in to MongoDB Atlas (https://cloud.mongodb.com)
# 2. Go to "Database" -> "Connect" -> "Drivers" -> Node.js
# 3. Replace <username> and <password> with your database user credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lmvs?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens:
JWT_SECRET=lmvs-production-secret-key-2026-secure
